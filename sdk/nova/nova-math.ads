------------------------------------------------------------------------------
--  Nova.Math : fixed-point arithmetic and trigonometry without an FPU.
--
--  Fixed is a genuine Ada fixed-point type: 24.8 bits in one 32-bit word,
--  so "X := X + Speed * 0.75;" compiles to plain integer instructions.
--  Angle is a modular type: 256 steps per turn, wrapping for free.
------------------------------------------------------------------------------

package Nova.Math is
   pragma Pure;

   type Fixed is delta 1.0 / 256.0 range -8_388_608.0 .. 8_388_607.0
     with Small => 1.0 / 256.0, Size => 32;

   type Angle is mod 256;

   function Sin (A : Angle) return Fixed with Inline;
   function Cos (A : Angle) return Fixed with Inline;

   --  Round toward negative infinity (Integer (F) would round to nearest).
   function Floor (F : Fixed) return Integer with Inline;

